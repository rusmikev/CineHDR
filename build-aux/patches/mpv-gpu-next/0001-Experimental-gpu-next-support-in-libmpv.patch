+
+struct framebuffer {
+    int fd;
+    uint32_t width;
+    uint32_t height;
+    uint32_t stride;
+    uint64_t size;
+    uint32_t handle;
+    uint8_t *map;
+    uint32_t id;
+};
+
+struct drm_hdr {
+    struct hdr_output_metadata metadata;
