+local function system_open(path)
+    local args
+    if platform == "windows" then
+        args = {"rundll32", "url.dll,FileProtocolHandler", path}
+    elseif platform == "darwin" then
+        args = {"open", path}
+    else
+        args = {"gio", "open", path}
+    end
+
+    mp.commandv("run", unpack(args))
+end
