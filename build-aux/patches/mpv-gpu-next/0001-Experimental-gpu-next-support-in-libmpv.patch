+}
diff --git a/ci/build-freebsd.sh b/ci/build-freebsd.sh
new file mode 100755
index 000000000..7ac7c4010
--- /dev/null
+++ b/ci/build-freebsd.sh
@@ -0,0 +1,32 @@
+#!/bin/sh
+set -e
+
+. ./ci/build-common.sh
+
+export CFLAGS="$CFLAGS -isystem/usr/local/include -march=native"
+export CXXFLAGS="$CXXFLAGS -isystem/usr/local/include"
+export LDFLAGS="$LDFLAGS -L/usr/local/lib"
+
+# TODO: re-add -Ddvbin=enabled
+
+mkdir -p subprojects
