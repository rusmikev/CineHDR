+    // Ensure that any in-flight vo_wayland_preferred_description_info get deallocated.
+    if (wl->display)
+        wl_display_roundtrip(wl->display);
+
+    if (wl->compositor)
+        wl_compositor_destroy(wl->compositor);
+
+    if (wl->subcompositor)
+        wl_subcompositor_destroy(wl->subcompositor);
