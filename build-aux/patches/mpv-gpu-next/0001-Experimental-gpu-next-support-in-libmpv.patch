+}
+
+int m_property_float_ro(int action, void *arg, float var)
+{
+    switch (action) {
+    case M_PROPERTY_GET:
+        *(float *)arg = var;
+        return M_PROPERTY_OK;
+    case M_PROPERTY_GET_TYPE:
+        *(struct m_option *)arg = (struct m_option){.type = CONF_TYPE_FLOAT};
