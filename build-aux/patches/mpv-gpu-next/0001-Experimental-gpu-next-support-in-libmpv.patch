diff --git a/video/out/gpu_next/libmpv_gl_pl.c b/video/out/gpu_next/libmpv_gl_pl.c
new file mode 100644
index 000000000..606dd550d
--- /dev/null
+++ b/video/out/gpu_next/libmpv_gl_pl.c
@@ -0,0 +1,124 @@
+/*
