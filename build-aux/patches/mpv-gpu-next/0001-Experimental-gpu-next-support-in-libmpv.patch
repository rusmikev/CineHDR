+static const char *track_type_name(struct track *t)
+{
+    if (t->image)
+        return "Image";
+
+    switch (t->type) {
+    case STREAM_VIDEO: return "Video";
+    case STREAM_AUDIO: return "Audio";
+    case STREAM_SUB: return "Sub";
+    }
+    return NULL;
+}
