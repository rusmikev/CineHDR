index 000000000..f9bc3e797
--- /dev/null
+++ b/misc/node.h
@@ -0,0 +1,24 @@
+#ifndef MP_MISC_NODE_H_
+#define MP_MISC_NODE_H_
+
+#include <stdbool.h>
