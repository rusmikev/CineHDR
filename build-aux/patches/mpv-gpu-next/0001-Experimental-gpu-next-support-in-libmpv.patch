+    struct vo_wayland_data_offer *o = s->dnd_offer;
+
+    if (o->offer) {
+        if (o->fd != -1)
+            return;
+        wl_data_offer_destroy(o->offer);
+        o->offer = NULL;
+    }
+
+    MP_VERBOSE(wl, "Releasing DND offer with mime type %s\n", o->mime_type);
+    if (o->mime_type)
+        TA_FREEP(&o->mime_type);
+    o->mime_score = 0;
+}
