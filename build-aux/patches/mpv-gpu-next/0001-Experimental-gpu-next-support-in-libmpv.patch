+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include <libavcodec/avcodec.h>
+
+#include "osdep/io.h"
+
+#include "mpv_talloc.h"
+#include "screenshot.h"
+#include "core.h"
