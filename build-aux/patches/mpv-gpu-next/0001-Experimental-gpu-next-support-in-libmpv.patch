+mp_cmd_t *mp_input_read_cmd(struct input_ctx *ictx)
+{
+    input_lock(ictx);
+    struct mp_cmd *ret = queue_remove_head(&ictx->cmd_queue);
+    if (!ret)
+        ret = check_autorepeat(ictx);
+    if (ret && ret->mouse_move) {
+        ictx->mouse_x = ret->mouse_x;
+        ictx->mouse_y = ret->mouse_y;
+    }
+    input_unlock(ictx);
+    return ret;
+}
