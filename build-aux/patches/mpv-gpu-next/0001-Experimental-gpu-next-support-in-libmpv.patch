new file mode 100644
index 000000000..678c12d4a
--- /dev/null
+++ b/video/out/opengl/utils.c
@@ -0,0 +1,278 @@
+/*
+ * This file is part of mpv.
+ * Parts based on MPlayer code by Reimar Döffinger.
