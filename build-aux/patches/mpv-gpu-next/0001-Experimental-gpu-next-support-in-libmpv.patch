+}
+
+int m_property_double_ro(int action, void *arg, double var)
+{
+    switch (action) {
+    case M_PROPERTY_GET:
+        *(double *)arg = var;
+        return M_PROPERTY_OK;
+    case M_PROPERTY_GET_TYPE:
+        *(struct m_option *)arg = (struct m_option){.type = CONF_TYPE_DOUBLE};
+        return M_PROPERTY_OK;
