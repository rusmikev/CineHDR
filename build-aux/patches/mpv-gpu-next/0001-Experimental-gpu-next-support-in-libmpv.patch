+        MP_VERBOSE(wl, "Disabling server decorations\n");
+    }
+    opts->border = mode == ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE;
+    m_config_cache_write_opt(wl->opts_cache, &opts->border);
