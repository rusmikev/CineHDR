+        end
+    end
+
+    return items
+end
+
+local function audio_devices()
+    local items = {}
+    local selected_device = get("audio-device")
+
+    for i, device in ipairs(get("audio-device-list")) do
+        items[i] = {
+            title = format_audio_device(device):gsub("&", "&&"),
+            cmd = "set audio-device " .. quote(device.name),
