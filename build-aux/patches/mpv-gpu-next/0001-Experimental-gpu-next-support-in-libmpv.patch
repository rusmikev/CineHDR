+        return M_PROPERTY_OK;
+    case M_PROPERTY_GET_CONSTRICTED_TYPE: {
+        struct m_option opt = {
+            .type = CONF_TYPE_INT,
+            .min = base,
+            .max = playlist_entry_count(pl) - 1 + base,
+        };
+        *(struct m_option *)arg = opt;
+        return M_PROPERTY_OK;
+    }
+    }
+    return M_PROPERTY_NOT_IMPLEMENTED;
