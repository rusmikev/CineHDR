+DEFINE_GUID(KSDATAFORMAT_SUBTYPE_IEC61937_MPEG3,
+            0x00000005, 0x0cea, 0x0010, 0x80, 0x00,
+            0x00, 0xaa, 0x00, 0x38, 0x9b, 0x71);
+#endif
