+void mp_msg(struct mp_log *log, int lev, const char *format, ...)
+    MP_PRINTF_ATTRIBUTE(3, 4);
+int mp_msg_find_level(const char *s);
+int mp_msg_level(struct mp_log *log);
+void mp_msg_set_max_level(struct mp_log *log, int lev);
