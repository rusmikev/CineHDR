+    makenode(tmp, &node, L, 1);
+    char *dst = talloc_strdup(tmp, "");
+    if (json_write(&dst, &node) >= 0) {
+        lua_pushstring(L, dst);
+        return 1;
+    }
+
+    lua_pushnil(L);
+    lua_pushstring(L, "error");
+    return 2;
+}
