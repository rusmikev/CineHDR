using Gtk 4.0;
using Adw 1;

template $HdrDiagnosticsDialog: Adw.Dialog {
  title: _("Video Output Diagnostics");
  name: "hdr-diagnostics";
  content-width: 520;
  content-height: 480;

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [end]
      Box {
        Button copy_btn {
          icon-name: "edit-copy-symbolic";
          tooltip-text: _("Copy diagnostics");
          styles [
            "flat",
          ]
          clicked => $_on_copy();
        }

        Button refresh_btn {
          icon-name: "view-refresh-symbolic";
          tooltip-text: _("Refresh");
          styles [
            "flat",
          ]
          clicked => $_on_refresh();
        }
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        title: _("Video Renderer");
        description: _("Changes apply after restarting CineHDR.");

        Adw.ActionRow renderer_active_row {
          title: _("Current Renderer");
          subtitle: "Checking...";
        }

        Adw.ActionRow renderer_configured_row {
          title: _("After Restart");
          subtitle: "Checking...";
        }

        Adw.ActionRow renderer_reason_row {
          title: _("Status");
          subtitle: "Checking...";
        }

        Adw.ActionRow renderer_target_row {
          title: _("Render Target");
          subtitle: "Checking...";
        }

        Adw.ActionRow renderer_requested_row {
          title: _("Requested This Session");
          subtitle: "Checking...";
          visible: false;
        }

        Adw.ActionRow renderer_dependency_row {
          title: _("Renderer Dependencies");
          subtitle: "Checking...";
          visible: false;
        }

        Adw.ActionRow gpu_next_capability_row {
          title: _("GPU Next Capability");
          subtitle: "Checking...";
          visible: false;
        }

        Adw.ActionRow dovi_capability_row {
          title: _("Dolby Vision Capability");
          subtitle: "Checking...";
          visible: false;
        }
      }

      Adw.PreferencesGroup {
        title: _("Output & Color State");
        description: _("Current GTK and OpenGL rendering surface status.");

        Adw.ActionRow status_row {
          title: _("HDR Status");
          subtitle: "Checking...";
        }

        Adw.ActionRow display_hdr_row {
          title: _("Display HDR Supported");
          subtitle: "Checking...";
        }

        Adw.ActionRow compositor_cm_row {
          title: _("Compositor Color Management");
          subtitle: "Checking...";
        }

        Adw.ActionRow monitor_hdr_row {
          title: _("Monitor HDR State");
          subtitle: "Checking...";
        }

        Adw.ActionRow offload_row {
          title: _("Graphics Offload (Direct Scanout)");
          subtitle: "Checking...";
        }

        Adw.ActionRow unsupported_reason_row {
          title: _("System HDR Limitation");
          subtitle: "Checking...";
        }

        Adw.ActionRow color_state_row {
          title: _("Gdk.ColorState");
          subtitle: "Checking...";
        }

        Adw.ActionRow texture_format_row {
          title: _("Surface Format");
          subtitle: "Checking...";
        }
      }

      Adw.PreferencesGroup {
        title: _("Video Signal (libmpv)");
        description: _("Parameters detected from the playing video stream.");

        Adw.ActionRow codec_row {
          title: _("Video Codec / Format");
          subtitle: "Checking...";
        }

        Adw.ActionRow resolution_row {
          title: _("Resolution & Pixel Format");
          subtitle: "Checking...";
        }

        Adw.ActionRow hwdec_row {
          title: _("Hardware Acceleration");
          subtitle: "Checking...";
        }

        Adw.ActionRow dovi_profile_row {
          title: _("Dolby Vision Profile");
          subtitle: "Checking...";
        }

        Adw.ActionRow primaries_row {
          title: _("Color Primaries");
          subtitle: "Checking...";
        }

        Adw.ActionRow trc_row {
          title: _("Transfer Characteristics (Gamma)");
          subtitle: "Checking...";
        }

        Adw.ActionRow peak_luma_row {
          title: _("Peak Luminance");
          subtitle: "Checking...";
        }

        Adw.ActionRow target_row {
          title: _("Target Tone Mapping");
          subtitle: "Checking...";
        }
      }

      Adw.PreferencesGroup {
        title: _("Playback Performance & Drops");
        description: _("Real-time video framerate and frame loss counters.");

        Adw.ActionRow perf_fps_row {
          title: _("Playback Framerate");
          subtitle: "Checking...";
        }

        Adw.ActionRow perf_dropped_row {
          title: _("Dropped Frames");
          subtitle: "Checking...";
        }

        Adw.ActionRow perf_delayed_row {
          title: _("Delayed & Mistimed Frames");
          subtitle: "Checking...";
        }

        Adw.ActionRow perf_rendered_row {
          title: _("Presented Frames");
          subtitle: "Checking...";
        }

        Adw.ActionRow perf_avsync_row {
          title: _("A/V Sync Offset");
          subtitle: "Checking...";
        }

        Adw.ActionRow perf_pipeline_row {
          title: _("Render Pipeline Status");
          subtitle: "Checking...";
        }
      }
    };
  }
}
