using Gtk 4.0;

template $HdrMenuButton: MenuButton {
  name: "hdr-options";

  styles [
    "circular",
    "flat",
  ]

  direction: up;
  halign: center;
  icon-name: "cine-hdr-symbolic";
  tooltip-text: _("HDR & Video Output");
  visible: true;

  popover: Popover {
    styles [
      "popover-scrolled",
    ]

    ScrolledWindow {
      propagate-natural-height: true;
      propagate-natural-width: true;

      Box {
        orientation: vertical;
        spacing: 8;

        Label {
          label: _("HDR & Video Output");
          halign: start;
          styles [
            "title-4",
          ]
        }

        Box {
          Box {
            halign: start;

            Button reset_btn {
              icon-name: "edit-undo-symbolic";
              tooltip-text: _("Reset HDR");
              styles [
                "flat",
              ]
              clicked => $_on_hdr_reset();
            }

            Label {
              label: _("HDR Mode");
              wrap: true;
              natural-wrap-mode: none;
              halign: start;
              margin-start: 8;
              styles [
                "heading",
              ]
            }
          }

          Separator {
            hexpand: true;
            opacity: 0;
            margin-end: 2;
          }

          DropDown hdr_mode_dropdown {
            halign: end;
            width-request: 140;
            focus-on-click: false;
            model: StringList {
              strings [
                _("Auto"),
                _("Force HDR"),
                _("Force SDR"),
              ]
            };
            notify::selected => $_on_hdr_mode_changed();
          }
        }

        Box hdr_peak_row {
          Box {
            halign: start;

            Button reset_peak_btn {
              icon-name: "edit-undo-symbolic";
              tooltip-text: _("Reset HDR Peak Brightness");
              styles [
                "flat",
              ]
              clicked => $_on_hdr_peak_reset();
            }

            Label {
              label: _("HDR Peak Brightness");
              wrap: true;
              natural-wrap-mode: none;
              halign: start;
              margin-start: 8;
              styles [
                "heading",
              ]
            }
          }

          Separator {
            hexpand: true;
            opacity: 0;
            margin-end: 2;
          }

          DropDown hdr_peak_dropdown {
            halign: end;
            width-request: 108;
            focus-on-click: false;
            model: StringList {
              strings [
                _("Auto"),
                "200 nits",
                "400 nits",
                "600 nits",
                "1000 nits",
                "1600 nits",
              ]
            };
            notify::selected => $_on_hdr_peak_changed();
          }
        }

        Separator {
          margin-top: 4;
          margin-bottom: 4;
        }

        Label {
          label: _("Video Renderer");
          halign: start;
          styles [
            "heading",
          ]
        }

        Label renderer_session_label {
          label: _("Current session: Not initialized");
          halign: start;
          xalign: 0;
          wrap: true;
          styles [
            "dim-label",
            "caption",
          ]
        }

        Box {
          spacing: 16;

          Box {
            orientation: vertical;
            hexpand: true;

            Label {
              label: _("GPU Next (Experimental)");
              halign: start;
              xalign: 0;
              wrap: true;
            }

            Label {
              label: _("Applies to HDR and SDR video. Restart CineHDR to apply.");
              halign: start;
              xalign: 0;
              wrap: true;
              styles [
                "dim-label",
                "caption",
              ]
            }
          }

          Switch gpu_next_switch {
            valign: center;
            notify::active => $_on_gpu_next_changed();
          }
        }

        Label renderer_restart_label {
          label: _("Restart required to use this renderer selection.");
          halign: start;
          xalign: 0;
          wrap: true;
          visible: false;
          styles [
            "warning",
            "caption",
          ]
        }

        Separator {
          margin-top: 4;
          margin-bottom: 4;
        }

        Button diag_btn {
          label: _("Video Output Diagnostics…");
          halign: center;
          styles [
            "pill",
          ]
          clicked => $_on_hdr_diagnostics();
        }
      }
    }
  };
}
